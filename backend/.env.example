# Copie este arquivo para `.env` e ajuste os valores.
#   cp .env.example .env
#
# O arquivo `.env` é ignorado pelo Git — nunca o commite.

# Conexão com o PostgreSQL (as migrations são aplicadas automaticamente no boot).
DATABASE_URL=postgres://concord-user:concord-password@localhost:5432/concord?sslmode=disable

# Segredo usado para assinar os tokens JWT (access + refresh).
# Gere um valor forte e único, por exemplo:
#   openssl rand -base64 48
JWT_SECRET=troque-por-um-segredo-forte-aqui
